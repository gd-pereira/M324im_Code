/*
 Traffic light pipeline (local Jenkins).

 Source: by default the repo is mounted read-only at /repo in the Jenkins
 container (see run-local.sh). Set REPO_URL to a public Git URL to clone
 from GitHub instead.
*/
pipeline {
  agent any
  tools { nodejs "node" }
  environment {
    REPO_URL = 'https://github.com/gd-pereira/M324im_Code.git'  // '' = use local /repo mount
    REPO_BRANCH = 'main'
    APP_DIR = '02/02_Exercises/01'
  }
  stages {
    stage('Get source') {
      steps {
        script {
          if (env.REPO_URL?.trim()) {
            git branch: env.REPO_BRANCH, url: env.REPO_URL
          } else {
            sh '''
              set -e
              rm -rf "$APP_DIR"
              mkdir -p "$APP_DIR"
              cp -a "/repo/$APP_DIR/." "$APP_DIR/"
              rm -rf "$APP_DIR/node_modules"
            '''
          }
        }
      }
    }
    stage('Install') {
      steps { dir(env.APP_DIR) { sh 'node --version && npm install' } }
    }
    stage('Run app') {
      steps { dir(env.APP_DIR) { sh 'node app.js green && node app.js red' } }
    }
    stage('Unit tests') {
      steps { dir(env.APP_DIR) { sh 'npm test' } }
    }
  }
}
